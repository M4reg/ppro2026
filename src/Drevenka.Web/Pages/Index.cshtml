@page
@model IndexModel
@{
    ViewData["Title"] = "Přehled skladu";
}

<!-- Hlavní řemeslný panel přehledu skladu -->
<div class="hero-craft-block mb-4">
    <div class="d-flex align-items-center gap-2 text-wood-pine small fw-bold text-uppercase mb-2">
        <i class="bi bi-box-seam-fill text-wood-terracotta"></i>
        <span>Interní skladový systém &bull; Dřevěnka s.r.o.</span>
    </div>
    <h1 class="h2 fw-bold text-wood-dark mb-2">
        Správa sortimentu a skladové zásoby
    </h1>
    <p class="text-secondary mb-4 col-lg-9" style="font-size: 0.95rem; line-height: 1.6;">
        Centrální evidence tradičních dřevěných hraček, sledování nákupních nákladů, maloobchodních cen a obchodních marží připravených pro e-shop a velkoobchodní expedici.
    </p>
    <div class="d-flex flex-wrap gap-2">
        <a asp-page="/Products/Index" class="btn btn-wood-pine shadow-sm">
            <i class="bi bi-grid me-1"></i> Otevřít katalog produktů
        </a>
        <a asp-page="/Products/Create" class="btn btn-wood-terracotta shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Přidat novou položku
        </a>
    </div>
</div>

<!-- Hlavní skladové metriky (Craftsman Grid) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="stat-box stat-box-pine">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted extra-small fw-bold text-uppercase">Položky v evidenci</span>
                    <div class="display-6 fw-bold text-wood-dark font-monospace mt-1">@Model.TotalProductsCount</div>
                </div>
                <div class="fs-3 text-wood-pine opacity-75"><i class="bi bi-boxes"></i></div>
            </div>
            <div class="pt-3 border-top border-wood-sand mt-3 d-flex align-items-center justify-content-between small">
                <span class="text-muted">Aktivní k prodeji:</span>
                <span class="badge badge-active font-monospace">@Model.ActiveProductsCount položek</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="stat-box stat-box-terracotta">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted extra-small fw-bold text-uppercase">Průměrná marže / zisk</span>
                    <div class="display-6 fw-bold text-wood-terracotta font-monospace mt-1">
                        @Model.AverageMargin.ToString("C0")
                    </div>
                </div>
                <div class="fs-3 text-wood-terracotta opacity-75"><i class="bi bi-graph-up"></i></div>
            </div>
            <div class="pt-3 border-top border-wood-sand mt-3 d-flex align-items-center justify-content-between small">
                <span class="text-muted">Hrubý zisk na kus:</span>
                <span class="text-success fw-bold font-monospace"><i class="bi bi-arrow-up-short"></i>+@(Model.AverageMargin.ToString("C0"))</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="stat-box stat-box-sand">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted extra-small fw-bold text-uppercase">Provozní status skladu</span>
                    <div class="h4 fw-bold text-wood-dark mt-2 mb-1">
                        <i class="bi bi-shield-check text-success me-1"></i>Expedice v pořádku
                    </div>
                </div>
                <div class="fs-3 text-wood-pine opacity-50"><i class="bi bi-truck"></i></div>
            </div>
            <div class="pt-3 border-top border-wood-sand mt-3 d-flex align-items-center justify-content-between small">
                <span class="text-muted">Stav synchronizace:</span>
                <span class="badge bg-success-subtle text-success">Připraveno</span>
            </div>
        </div>
    </div>
</div>

<!-- Rychlý náhled sortimentu -->
<div class="card mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <div class="fw-bold text-wood-dark d-flex align-items-center gap-2">
            <i class="bi bi-view-list text-wood-terracotta"></i>
            <span>Aktuální sortiment hraček Dřevěnka</span>
        </div>
        <a asp-page="/Products/Index" class="btn btn-sm btn-outline-wood-pine">Zobrazit celý katalog</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 130px;">Kód (SKU)</th>
                    <th>Produkt</th>
                    <th class="text-end" style="width: 140px;">Nákupní cena</th>
                    <th class="text-end" style="width: 160px;">Prodejní cena</th>
                    <th class="text-center" style="width: 120px;">Stav</th>
                    <th class="text-end" style="width: 90px;">Detail</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.RecentProducts)
                {
                    <tr>
                        <td><span class="badge badge-sku">@p.Code</span></td>
                        <td class="fw-semibold text-wood-dark">@p.Name</td>
                        <td class="text-end price-display price-purchase">@p.PurchasePrice.ToString("C2")</td>
                        <td class="text-end price-display price-selling">
                            <span class="margin-arrow-up"><i class="bi bi-arrow-up-short"></i></span>@p.SellingPrice.ToString("C2")
                        </td>
                        <td class="text-center">
                            @if (p.IsActive)
                            {
                                <span class="badge badge-active"><i class="bi bi-check2 me-1"></i>Aktivní</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Neaktivní</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-page="/Products/Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-wood-pine" title="Zobrazit detail">
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
