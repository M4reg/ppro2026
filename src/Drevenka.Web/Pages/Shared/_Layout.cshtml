<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dřevěnka s.r.o. | Skladový systém</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Drevenka.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-md navbar-dark navbar-wood shadow-sm">
            <div class="app-container d-flex align-items-center justify-content-between">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <span class="fs-4 text-wood-terracotta"><i class="bi bi-box-seam-fill"></i></span>
                    <div>
                        <span class="d-block lh-1 fw-bold fs-5 text-white">Dřevěnka s.r.o.</span>
                        <span class="brand-sub d-block">Skladový a expediční systém</span>
                    </div>
                </a>
                <button class="navbar-toggler border-0 p-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Přepnout navigaci">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0 ms-md-4 gap-md-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">
                                <i class="bi bi-speedometer2 me-1"></i> Přehled skladu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Products/Index">
                                <i class="bi bi-grid me-1"></i> Katalog produktů
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Products/Create">
                                <i class="bi bi-plus-lg me-1"></i> Nová položka
                            </a>
                        </li>
                    </ul>
                    <div class="nav-user-panel d-flex align-items-center justify-content-between justify-content-md-end gap-3">
                        <span class="craft-status-tag d-inline-flex border border-wood-sand px-2 py-1 bg-wood-pine">
                            <span class="dot"></span> Sklad online
                        </span>
                        <div class="d-flex align-items-center gap-2 text-wood-sand small">
                            <i class="bi bi-person-circle fs-5 text-wood-terracotta"></i>
                            <div class="d-flex flex-column lh-1">
                                <span class="fw-semibold text-white">Petr Doležal</span>
                                <span class="extra-small text-wood-sand opacity-75">Skladník</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="app-container py-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer mt-auto">
        <div class="app-container d-flex flex-column flex-md-row justify-content-between align-items-center small gap-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-tree-fill text-wood-terracotta fs-5"></i>
                <div class="text-wood-sand">
                    &copy; 2026 <strong>Dřevěnka s.r.o.</strong> &bull; Tradiční české dřevěné hračky &bull; Interní skladový systém
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="craft-status-tag">
                    <span class="dot"></span> V provozu
                </span>
                <span class="text-wood-sand opacity-50">&bull;</span>
                <span class="text-wood-sand opacity-75">Verze 1.2</span>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
