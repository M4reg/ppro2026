@page
@model Drevenka.Web.Pages.WarehousePages.IndexModel
@{
    ViewData["Title"] = "Přehled skladu & Zásoby";
}

<!-- Drobečková navigace -->
<div class="custom-breadcrumb-bar">
    <a asp-page="/Index"><i class="bi bi-house-door me-1"></i> Sklad Dřevěnka</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <span class="current">Přehled skladových zásob</span>
</div>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1 fw-bold text-wood-dark">
            <i class="bi bi-boxes text-wood-terracotta me-2"></i>Stav zásob na skladech
        </h1>
        <p class="text-muted small mb-0">Evidence fyzických zásob, rezervací a disponibilních kusů pro Hradec Králové a garáž v Třebechovicích.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./Movements" class="btn btn-outline-wood-pine px-3 py-2 fw-semibold">
            <i class="bi bi-clock-history me-1"></i> Historie pohybů
        </a>
        <a asp-page="./Operations" class="btn btn-wood-pine px-3 py-2 shadow-sm fw-semibold">
            <i class="bi bi-arrow-left-right me-1"></i> Skladové operace
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 bg-success-subtle text-success-emphasis" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zavřít"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 bg-danger-subtle text-danger-emphasis" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zavřít"></button>
    </div>
}

<!-- Metriky skladu (KPI karty) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted extra-small text-uppercase fw-bold">Fyzicky na skladě</span>
                    <h3 class="fw-bold text-wood-dark mb-0 font-monospace mt-1">@Model.TotalStockCount <span class="fs-6 fw-normal text-muted">ks</span></h3>
                </div>
                <div class="fs-1 text-wood-terracotta opacity-75"><i class="bi bi-box-seam"></i></div>
            </div>
            <div class="extra-small text-muted mt-2">Součet kusů na regálech</div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted extra-small text-uppercase fw-bold">Disponibilní zásoba</span>
                    <h3 class="fw-bold text-wood-pine mb-0 font-monospace mt-1">@Model.TotalAvailableCount <span class="fs-6 fw-normal text-muted">ks</span></h3>
                </div>
                <div class="fs-1 text-wood-pine opacity-75"><i class="bi bi-cart-check"></i></div>
            </div>
            <div class="extra-small text-muted mt-2">Volné k prodeji na e-shopu</div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3 h-100 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted extra-small text-uppercase fw-bold">Rezervováno</span>
                    <h3 class="fw-bold text-wood-dark mb-0 font-monospace mt-1">@Model.TotalReservedCount <span class="fs-6 fw-normal text-muted">ks</span></h3>
                </div>
                <div class="fs-1 text-secondary opacity-50"><i class="bi bi-bookmark-check"></i></div>
            </div>
            <div class="extra-small text-muted mt-2">V rozpracovaných objednávkách</div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm p-3 h-100 @(Model.LowStockCount > 0 ? "bg-warning-subtle border-warning" : "bg-white")">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted extra-small text-uppercase fw-bold">Položky pod minimem</span>
                    <h3 class="fw-bold @(Model.LowStockCount > 0 ? "text-danger" : "text-wood-dark") mb-0 font-monospace mt-1">
                        @Model.LowStockCount <span class="fs-6 fw-normal text-muted">položek</span>
                    </h3>
                </div>
                <div class="fs-1 @(Model.LowStockCount > 0 ? "text-danger" : "text-muted") opacity-75">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
            </div>
            <div class="extra-small text-muted mt-2">Doporučeno zadat do výroby</div>
        </div>
    </div>
</div>

<!-- Filtrační lišta -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-5 col-lg-6">
                <div class="input-group">
                    <span class="input-group-text bg-white border-wood-sand text-wood-terracotta"><i class="bi bi-search"></i></span>
                    <input type="text" asp-for="SearchTerm" class="form-control border-wood-sand ps-2" placeholder="Hledat produkt nebo SKU kód..." />
                </div>
            </div>

            <div class="col-12 col-sm-6 col-md-3">
                <select asp-for="WarehouseId" asp-items="Model.WarehouseOptions" class="form-select border-wood-sand">
                    <option value="">Všechny sklady (HK i Garáž)</option>
                </select>
            </div>

            <div class="col-12 col-sm-6 col-md-2">
                <div class="form-check pt-2">
                    <input class="form-check-input" type="checkbox" asp-for="LowStockOnly" id="lowStockCheck" />
                    <label class="form-check-label extra-small fw-bold text-uppercase text-wood-dark" for="lowStockCheck">
                        Jen pod minimem
                    </label>
                </div>
            </div>

            <div class="col-12 col-md-2 col-lg-1 d-flex gap-1">
                <button type="submit" class="btn btn-wood-terracotta w-100 fw-semibold">
                    <i class="bi bi-funnel-fill"></i>
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.WarehouseId.HasValue || Model.LowStockOnly)
                {
                    <a asp-page="./Index" class="btn btn-outline-secondary" title="Zrušit filtry">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Tabulka skladových zásob -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 120px;">SKU</th>
                    <th>Produkt</th>
                    <th style="width: 220px;">Sklad</th>
                    <th class="text-end" style="width: 120px;">Fyzicky na skladě</th>
                    <th class="text-end" style="width: 110px;">Rezervováno</th>
                    <th class="text-end" style="width: 130px;">Disponibilní zásoba</th>
                    <th class="text-end" style="width: 110px;">Min. zásoba</th>
                    <th class="text-center" style="width: 130px;">Stav</th>
                    <th class="text-end" style="width: 140px;">Akce</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.StockItems.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block text-wood-terracotta mb-2"></i>
                            Podle zadaných kritérií nebyly nalezeny žádné skladové položky.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.StockItems)
                    {
                        <tr class="@(item.IsLowStock ? "table-warning bg-warning-subtle" : "")">
                            <td>
                                <span class="badge badge-sku">@item.Product.Code</span>
                            </td>
                            <td>
                                <strong class="text-wood-dark d-block">@item.Product.Name</strong>
                                @if (item.Product.ProductCategories.Any())
                                {
                                    <span class="text-muted extra-small">
                                        @string.Join(", ", item.Product.ProductCategories.Select(pc => pc.Category.Name))
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="fw-semibold text-wood-dark">
                                    <i class="bi @(item.Warehouse.IsMain ? "bi-building text-wood-pine" : "bi-shop text-wood-terracotta") me-1"></i>
                                    @item.Warehouse.Name
                                </span>
                            </td>
                            <td class="text-end font-monospace fs-6 fw-bold text-wood-dark">
                                @item.QuantityOnHand ks
                            </td>
                            <td class="text-end font-monospace text-muted">
                                @item.ReservedQuantity ks
                            </td>
                            <td class="text-end font-monospace fs-6 fw-bold @(item.AvailableQuantity > 0 ? "text-wood-pine" : "text-danger")">
                                @item.AvailableQuantity ks
                            </td>
                            <td class="text-end font-monospace text-muted small">
                                @item.MinStockLevel ks
                            </td>
                            <td class="text-center">
                                @if (item.IsLowStock)
                                {
                                    <span class="badge bg-danger px-2 py-1">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Pod minimem
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-active px-2 py-1">
                                        <i class="bi bi-check-circle me-1"></i>V pořádku
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="./Operations" asp-route-productId="@item.ProductId" asp-route-warehouseId="@item.WarehouseId" 
                                   class="btn btn-sm btn-outline-wood-pine" title="Provést skladový pohyb">
                                    <i class="bi bi-arrow-left-right me-1"></i> Pohyb
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

