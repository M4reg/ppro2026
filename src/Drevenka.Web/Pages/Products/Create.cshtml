@page
@model Drevenka.Web.Pages.Products.CreateModel
@{
    ViewData["Title"] = "Nová položka";
}

<!-- Drobečková navigace - jednotná šířka přes celý kontejner -->
<div class="custom-breadcrumb-bar">
    <a asp-page="/Index"><i class="bi bi-house-door me-1"></i> Sklad Dřevěnka</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <a asp-page="./Index">Katalog produktů</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <span class="current">Přidat položku</span>
</div>

<div class="card mb-4">
    <div class="card-header bg-white py-3 border-bottom border-wood-sand">
        <h2 class="h4 mb-1 fw-bold text-wood-dark">
            <i class="bi bi-plus-lg text-wood-terracotta me-2"></i>Založení nové položky v evidenci skladu
        </h2>
        <span class="text-muted small">Vyplňte parametry dřevěné hračky. Kód SKU musí být v systému jedinečný.</span>
    </div>
    <div class="card-body p-4">
        <form method="post" id="createProductForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0" role="alert"></div>

            <div class="row g-4">
                <!-- Levý sloupec: Základní identifikační údaje -->
                <div class="col-12 col-lg-7 d-flex flex-column gap-3">
                    <div class="row g-3">
                        <div class="col-12 col-md-5">
                            <label asp-for="Input.Code" class="form-label fw-semibold text-wood-dark extra-small text-uppercase"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-wood-sand-subtle border-wood-sand text-wood-terracotta"><i class="bi bi-upc-scan"></i></span>
                                <input asp-for="Input.Code" class="form-control border-wood-sand font-monospace text-uppercase" placeholder="např. KAC-002" autofocus />
                            </div>
                            <span asp-validation-for="Input.Code" class="text-danger small"></span>
                            <div class="form-text small">Kód SKU (např. VLK-002, KOS-100).</div>
                        </div>

                        <div class="col-12 col-md-7">
                            <label asp-for="Input.Name" class="form-label fw-semibold text-wood-dark extra-small text-uppercase"></label>
                            <input asp-for="Input.Name" class="form-control border-wood-sand" placeholder="např. Dřevěná káča dvoubarevná" />
                            <span asp-validation-for="Input.Name" class="text-danger small"></span>
                        </div>
                    </div>

                    <div>
                        <label asp-for="Input.Description" class="form-label fw-semibold text-wood-dark extra-small text-uppercase"></label>
                        <textarea asp-for="Input.Description" class="form-control border-wood-sand" rows="3" placeholder="Popis výrobku, materiál (např. masivní buk, voskovaná povrchová úprava), rozměry apod."></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger small"></span>
                    </div>

                    <div>
                        <label class="form-label fw-semibold text-wood-dark extra-small text-uppercase">
                            <i class="bi bi-tags text-wood-terracotta me-1"></i>Zařazení do kategorií
                        </label>
                        @if (Model.AvailableCategories.Any())
                        {
                            <div class="border border-wood-sand p-3 bg-wood-sand-subtle">
                                <div class="row g-2">
                                    @foreach (var cat in Model.AvailableCategories)
                                    {
                                        <div class="col-12 col-sm-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="SelectedCategoryIds" value="@cat.Id" id="cat_@cat.Id"
                                                       @(Model.SelectedCategoryIds.Contains(cat.Id) ? "checked" : "") />
                                                <label class="form-check-label small fw-semibold text-wood-dark" for="cat_@cat.Id">
                                                    @cat.Name
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="form-text small">Produkt může patřit do více kategorií současně (např. „Pro nejmenší“ i „Dárky do 300 Kč“).</div>
                        }
                        else
                        {
                            <div class="text-muted small fst-italic">Zatím nejsou vytvořeny žádné kategorie. <a asp-page="/Categories/Create" target="_blank">Vytvořit novou kategorii</a></div>
                        }
                    </div>
                </div>

                <!-- Pravý sloupec: Cenotvorba & Živý náhled marže -->
                <div class="col-12 col-lg-5 d-flex flex-column gap-3">
                    <div class="p-3 bg-wood-sand-subtle border border-wood-sand">
                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label asp-for="Input.PurchasePrice" class="form-label fw-semibold text-wood-dark extra-small text-uppercase"></label>
                                <div class="input-group">
                                    <input asp-for="Input.PurchasePrice" type="number" step="0.50" min="0" class="form-control border-wood-sand text-end font-monospace" id="purchasePriceInput" oninput="calculateMargin()" />
                                    <span class="input-group-text bg-white border-wood-sand text-wood-dark">Kč</span>
                                </div>
                                <span asp-validation-for="Input.PurchasePrice" class="text-danger small"></span>
                                <div class="text-muted extra-small mt-1">Náklad bez DPH</div>
                            </div>

                            <div class="col-12 col-sm-6">
                                <label asp-for="Input.SellingPrice" class="form-label fw-semibold text-wood-dark extra-small text-uppercase"></label>
                                <div class="input-group">
                                    <input asp-for="Input.SellingPrice" type="number" step="1.00" min="0" class="form-control border-wood-sand text-end font-monospace" id="sellingPriceInput" oninput="calculateMargin()" />
                                    <span class="input-group-text bg-white border-wood-sand text-wood-dark">Kč</span>
                                </div>
                                <span asp-validation-for="Input.SellingPrice" class="text-danger small"></span>
                                <div class="text-muted extra-small mt-1">Koncová cena pro e-shop</div>
                            </div>
                        </div>

                        <!-- Živá kalkulace marže -->
                        <div class="pt-3 border-top border-wood-sand mt-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted extra-small text-uppercase fw-bold">Zisk na kusu:</div>
                                <div class="fw-bold fs-5 price-display text-wood-dark" id="marginKcs">0,00 Kč</div>
                            </div>
                            <div class="text-end">
                                <div class="text-muted extra-small text-uppercase fw-bold">Marže:</div>
                                <span class="badge badge-active fs-6" id="marginPercent">0 %</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a asp-page="./Index" class="btn btn-outline-wood-pine">
                            <i class="bi bi-arrow-left me-1"></i> Zpět do katalogu
                        </a>
                        <button type="submit" class="btn btn-wood-pine px-4 shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Uložit produkt
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function calculateMargin() {
            const purchase = parseFloat(document.getElementById('purchasePriceInput').value) || 0;
            const selling = parseFloat(document.getElementById('sellingPriceInput').value) || 0;
            const margin = selling - purchase;
            const percent = purchase > 0 ? (margin / purchase) * 100 : 0;

            document.getElementById('marginKcs').innerText = margin.toLocaleString('cs-CZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Kč';
            const badge = document.getElementById('marginPercent');
            badge.innerText = (percent >= 0 ? '+' : '') + percent.toFixed(0) + ' %';
            if (percent < 0) {
                badge.className = 'badge bg-danger fs-6';
            } else if (percent < 30) {
                badge.className = 'badge badge-margin fs-6';
            } else {
                badge.className = 'badge badge-active fs-6';
            }
        }
        calculateMargin();
    </script>
}
