@page
@model Drevenka.Web.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Katalog produktů";
}

<!-- Drobečková navigace -->
<div class="custom-breadcrumb-bar">
    <a asp-page="/Index"><i class="bi bi-house-door me-1"></i> Sklad Dřevěnka</a>
    <span class="sep"><i class="bi bi-chevron-right"></i></span>
    <span class="current">Katalog produktů</span>
</div>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1 fw-bold text-wood-dark">
            <i class="bi bi-box-seam text-wood-terracotta me-2"></i>Katalog dřevěných hraček
        </h1>
        <p class="text-muted small mb-0">Kompletní sortimentní evidence a správa cen položek dílny Dřevěnka s.r.o.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Categories/Index" class="btn btn-outline-wood-pine px-3 py-2 fw-semibold">
            <i class="bi bi-tags me-1"></i> Správa kategorií
        </a>
        <a asp-page="./Create" class="btn btn-wood-pine px-3 py-2 shadow-sm fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> Nová položka
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 bg-success-subtle text-success-emphasis" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zavřít"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 bg-danger-subtle text-danger-emphasis" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zavřít"></button>
    </div>
}

<!-- Panel vyhledávání a filtrů -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3 p-md-4">
        <form method="get" class="d-flex flex-column gap-3">
            <!-- 1. Řádek: Rychlé a hromadné vyhledávání -->
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-9 col-lg-10">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-wood-sand text-wood-terracotta">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" asp-for="SearchTerm" class="form-control border-wood-sand ps-2" 
                               placeholder="Hledat název nebo více SKU kódů oddělených čárkou či mezerou (např. KAC-001, VLK-001)..." />
                    </div>
                </div>
                <div class="col-12 col-md-3 col-lg-2">
                    <button type="submit" class="btn btn-wood-pine w-100 fw-semibold d-flex align-items-center justify-content-center gap-1 shadow-sm">
                        <i class="bi bi-search"></i> Vyhledat
                    </button>
                </div>
            </div>

            <!-- 2. Řádek: Parametrické filtry & řazení -->
            <div class="p-3 bg-wood-sand-subtle border border-wood-sand">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-sm-6 col-md-3">
                        <label class="form-label extra-small text-uppercase fw-bold text-wood-dark mb-1">
                            <i class="bi bi-tag me-1"></i>Kategorie
                        </label>
                        <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select form-select-sm border-wood-sand">
                            <option value="">Všechny kategorie</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-md-2">
                        <label class="form-label extra-small text-uppercase fw-bold text-wood-dark mb-1">
                            <i class="bi bi-toggle2-on me-1"></i>Stav nabídky
                        </label>
                        <select asp-for="StatusFilter" class="form-select form-select-sm border-wood-sand">
                            <option value="all">Všechny položky</option>
                            <option value="active">Pouze aktivní</option>
                            <option value="inactive">Pouze neaktivní</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-6 col-md-3">
                        <label class="form-label extra-small text-uppercase fw-bold text-wood-dark mb-1">
                            <i class="bi bi-sort-down me-1"></i>Řadit podle
                        </label>
                        <select asp-for="SortBy" class="form-select form-select-sm border-wood-sand">
                            <option value="name_asc">Název (A – Z)</option>
                            <option value="name_desc">Název (Z – A)</option>
                            <option value="price_asc">Prodejní cena (od nejnižší)</option>
                            <option value="price_desc">Prodejní cena (od nejvyšší)</option>
                            <option value="margin_desc">Nejvyšší marže / zisk</option>
                            <option value="code_asc">Kód SKU (A – Z)</option>
                        </select>
                    </div>

                    <div class="col-6 col-sm-3 col-md-1">
                        <label class="form-label extra-small text-uppercase fw-bold text-wood-dark mb-1">Od (Kč)</label>
                        <input type="number" step="10" min="0" asp-for="MinPrice" class="form-control form-control-sm border-wood-sand text-end font-monospace" placeholder="0" />
                    </div>

                    <div class="col-6 col-sm-3 col-md-1">
                        <label class="form-label extra-small text-uppercase fw-bold text-wood-dark mb-1">Do (Kč)</label>
                        <input type="number" step="10" min="0" asp-for="MaxPrice" class="form-control form-control-sm border-wood-sand text-end font-monospace" placeholder="max" />
                    </div>

                    <div class="col-12 col-sm-6 col-md-2 d-flex gap-2 align-items-end pt-sm-4">
                        <button type="submit" class="btn btn-wood-terracotta btn-sm flex-grow-1 fw-semibold shadow-sm" title="Aplikovat vybrané filtry">
                            <i class="bi bi-funnel-fill me-1"></i> Filtrovat
                        </button>
                        @if (Model.HasActiveFilters)
                        {
                            <a asp-page="./Index" class="btn btn-outline-secondary btn-sm" title="Vymazat filtry a hledání">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Statistiky a stav výpisu -->
<div class="d-flex justify-content-between align-items-center mb-3 text-muted small">
    <div>
        Nalezeno položek: <strong class="text-wood-dark font-monospace fs-6">@Model.Products.Count</strong>
        @if (Model.HasActiveFilters)
        {
            <span class="badge badge-margin ms-2">Aktivní filtr</span>
            <a asp-page="./Index" class="text-wood-terracotta ms-2 text-decoration-none fw-semibold">
                <i class="bi bi-arrow-counterclockwise"></i> Resetovat
            </a>
        }
    </div>
    <div class="d-none d-md-inline text-wood-pine">
        <i class="bi bi-info-circle me-1"></i>Všechny prodejní ceny jsou uvedeny včetně marže pro maloobchod.
    </div>
</div>

@if (!Model.Products.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center my-4">
        <div class="display-6 text-wood-terracotta mb-3"><i class="bi bi-inbox"></i></div>
        <h4 class="fw-bold text-wood-dark">Nebyly nalezeny žádné produkty</h4>
        <p class="text-muted">Podle zadaných vyhledávacích a filtračních kritérií nebyla nalezena žádná položka.</p>
        <div class="mt-2 d-flex justify-content-center gap-2">
            @if (Model.HasActiveFilters)
            {
                <a asp-page="./Index" class="btn btn-outline-wood-pine"><i class="bi bi-arrow-counterclockwise me-1"></i> Zrušit filtry</a>
            }
            <a asp-page="./Create" class="btn btn-wood-pine"><i class="bi bi-plus-lg me-1"></i> Vytvořit nový produkt</a>
        </div>
    </div>
}
else
{
    <!-- Desktopová tabulka -->
    <div class="card border-0 shadow-sm d-none d-lg-block">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 130px;">Kód (SKU)</th>
                        <th>Název, kategorie a popis</th>
                        <th class="text-end" style="width: 140px;">Nákupní cena</th>
                        <th class="text-end" style="width: 150px;">Prodejní cena</th>
                        <th class="text-end" style="width: 120px;">Marže</th>
                        <th class="text-center" style="width: 110px;">Stav</th>
                        <th class="text-end" style="width: 160px;">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Products)
                    {
                        var margin = item.SellingPrice - item.PurchasePrice;
                        var marginPercent = item.PurchasePrice > 0 ? (margin / item.PurchasePrice) * 100 : 100;
                        <tr class="@(!item.IsActive ? "opacity-75 bg-light" : "")">
                            <td>
                                <span class="badge badge-sku">@item.Code</span>
                            </td>
                            <td>
                                <a asp-page="./Details" asp-route-id="@item.Id" class="fw-bold text-decoration-none text-wood-dark d-block">
                                    @item.Name
                                </a>
                                @if (item.ProductCategories.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1 my-1">
                                        @foreach (var pc in item.ProductCategories)
                                        {
                                            <span class="badge bg-white text-wood-dark border border-wood-sand" style="font-size: 0.72rem; font-weight: 500;">
                                                <i class="bi bi-tag-fill text-wood-terracotta me-1"></i>@pc.Category.Name
                                            </span>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <span class="text-muted small text-truncate d-block" style="max-width: 380px;">@item.Description</span>
                                }
                            </td>
                            <td class="text-end price-display price-purchase">@item.PurchasePrice.ToString("C2")</td>
                            <td class="text-end price-display price-selling">
                                <span class="margin-arrow-up"><i class="bi bi-arrow-up-short"></i></span>@item.SellingPrice.ToString("C2")
                            </td>
                            <td class="text-end">
                                <span class="badge @(marginPercent >= 100 ? "badge-active" : "badge-margin")">
                                    <i class="bi bi-graph-up me-1"></i>+@marginPercent.ToString("F0") %
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-active"><i class="bi bi-check2 me-1"></i>Aktivní</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Neaktivní</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-wood-pine" title="Zobrazit detail"><i class="bi bi-eye"></i></a>
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-wood-terracotta" title="Upravit"><i class="bi bi-pencil"></i></a>
                                    @if (item.IsActive)
                                    {
                                        <form method="post" asp-page-handler="Deactivate" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('Opravdu chcete produkt deaktivovat?');">
                                            <button type="submit" class="btn btn-outline-danger" title="Deaktivovat"><i class="bi bi-pause-circle"></i></button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Activate" asp-route-id="@item.Id" class="d-inline">
                                            <button type="submit" class="btn btn-outline-success" title="Aktivovat"><i class="bi bi-play-circle"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Mobilní a tabletové zobrazení (Karty) -->
    <div class="d-lg-none row g-3">
        @foreach (var item in Model.Products)
        {
            var margin = item.SellingPrice - item.PurchasePrice;
            var marginPercent = item.PurchasePrice > 0 ? (margin / item.PurchasePrice) * 100 : 100;
            <div class="col-12 col-md-6">
                <div class="card border-0 shadow-sm h-100 @(!item.IsActive ? "opacity-75 bg-light" : "")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge badge-sku">@item.Code</span>
                            @if (item.IsActive)
                            {
                                <span class="badge badge-active"><i class="bi bi-check2 me-1"></i>Aktivní</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Neaktivní</span>
                            }
                        </div>
                        <h5 class="card-title fw-bold mb-1">
                            <a asp-page="./Details" asp-route-id="@item.Id" class="text-decoration-none text-wood-dark">@item.Name</a>
                        </h5>
                        @if (item.ProductCategories.Any())
                        {
                            <div class="d-flex flex-wrap gap-1 my-2">
                                @foreach (var pc in item.ProductCategories)
                                {
                                    <span class="badge bg-wood-sand text-wood-dark" style="font-size: 0.72rem; font-weight: 500;">
                                        <i class="bi bi-tag-fill text-wood-terracotta me-1"></i>@pc.Category.Name
                                    </span>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p class="card-text text-muted small mb-3">@item.Description</p>
                        }
                        <div class="bg-wood-sand-subtle p-2 rounded mb-3 border border-wood-sand">
                            <div class="row text-center">
                                <div class="col-6 border-end border-wood-sand">
                                    <div class="text-muted extra-small">Nákup</div>
                                    <div class="price-display price-purchase">@item.PurchasePrice.ToString("C2")</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-muted extra-small">Prodej</div>
                                    <div class="price-display price-selling">
                                        <span class="margin-arrow-up"><i class="bi bi-arrow-up-short"></i></span>@item.SellingPrice.ToString("C2")
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge badge-margin">Marže: +@marginPercent.ToString("F0") %</span>
                            <div class="btn-group btn-group-sm">
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-wood-pine">Detail</a>
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-wood-terracotta">Upravit</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
