@page "{id:int}"
@model Drevenka.Web.Pages.Products.DetailsModel
@{
    ViewData["Title"] = "Detail: " + Model.Product.Name;
    var margin = Model.Product.SellingPrice - Model.Product.PurchasePrice;
    var marginPercent = Model.Product.PurchasePrice > 0 ? (margin / Model.Product.PurchasePrice) * 100 : 100;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-page="/Index">Sklad Dřevěnka</a></li>
                <li class="breadcrumb-item"><a asp-page="./Index">Katalog produktů</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Product.Name</li>
            </ol>
        </nav>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-dark font-monospace fs-6 px-3 py-2">@Model.Product.Code</span>
                    @if (Model.Product.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Aktivní v prodeji</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Neaktivní</span>
                    }
                </div>
                <div>
                    <a asp-page="./Edit" asp-route-id="@Model.Product.Id" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil me-1"></i> Upravit
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <h1 class="h3 fw-bold text-dark mb-2">@Model.Product.Name</h1>

                @if (!string.IsNullOrWhiteSpace(Model.Product.Description))
                {
                    <p class="text-secondary fs-6 mb-4">@Model.Product.Description</p>
                }
                else
                {
                    <p class="text-muted fst-italic mb-4">K tomuto produktu zatím nebyl vyplněn podrobnější popis.</p>
                }

                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded text-center border">
                            <div class="text-muted small mb-1">Nákupní cena</div>
                            <div class="fs-4 fw-bold font-monospace text-dark">@Model.Product.PurchasePrice.ToString("C2")</div>
                            <div class="text-muted extra-small">bez DPH</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded text-center border">
                            <div class="text-muted small mb-1">Prodejní cena</div>
                            <div class="fs-4 fw-bold font-monospace text-success">@Model.Product.SellingPrice.ToString("C2")</div>
                            <div class="text-muted extra-small">koncová cena</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-light rounded text-center border">
                            <div class="text-muted small mb-1">Zisk na kusu (marže)</div>
                            <div class="fs-4 fw-bold font-monospace text-primary">@margin.ToString("C2")</div>
                            <div class="extra-small">
                                <span class="badge bg-success-subtle text-success">+@marginPercent.ToString("F0") %</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="border rounded p-3 bg-body-tertiary">
                    <h6 class="fw-bold mb-2"><i class="bi bi-clock-history me-1 text-muted"></i>Systémové informace</h6>
                    <div class="row small text-muted">
                        <div class="col-6">Vytvořeno: <strong>@Model.Product.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong></div>
                        <div class="col-6">Poslední úprava: <strong>@(Model.Product.UpdatedAt.HasValue ? Model.Product.UpdatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "Původní stav")</strong></div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-between">
                    <a asp-page="./Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Zpět na přehled produktů
                    </a>
                    <a asp-page="./Edit" asp-route-id="@Model.Product.Id" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i> Upravit produkt
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
