@page "{id:int}"
@model Drevenka.Web.Pages.Products.DetailsModel
@{
    ViewData["Title"] = "Detail: " + Model.Product.Name;
    var margin = Model.Product.SellingPrice - Model.Product.PurchasePrice;
    var marginPercent = Model.Product.PurchasePrice > 0 ? (margin / Model.Product.PurchasePrice) * 100 : 100;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <!-- Drobečková navigace -->
        <div class="custom-breadcrumb-bar">
            <a asp-page="/Index"><i class="bi bi-house-door me-1"></i> Sklad</a>
            <span class="sep"><i class="bi bi-chevron-right"></i></span>
            <a asp-page="./Index">Katalog produktů</a>
            <span class="sep"><i class="bi bi-chevron-right"></i></span>
            <span class="current">@Model.Product.Name</span>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge badge-sku fs-6 px-3 py-2">@Model.Product.Code</span>
                    @if (Model.Product.IsActive)
                    {
                        <span class="badge badge-active px-2 py-1"><i class="bi bi-check2 me-1"></i>Aktivní v nabídce</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1">Neaktivní položka</span>
                    }
                </div>
                <div>
                    <a asp-page="./Edit" asp-route-id="@Model.Product.Id" class="btn btn-outline-wood-terracotta btn-sm">
                        <i class="bi bi-pencil me-1"></i> Upravit
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <h1 class="h3 fw-bold text-wood-dark mb-2">@Model.Product.Name</h1>

                @if (!string.IsNullOrWhiteSpace(Model.Product.Description))
                {
                    <p class="text-secondary fs-6 mb-4">@Model.Product.Description</p>
                }
                else
                {
                    <p class="text-muted fst-italic mb-4">K tomuto produktu zatím nebyl vyplněn podrobnější popis.</p>
                }

                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-wood-sand-subtle text-center border border-wood-sand">
                            <div class="text-muted small mb-1">Nákupní cena</div>
                            <div class="fs-4 price-display price-purchase">@Model.Product.PurchasePrice.ToString("C2")</div>
                            <div class="text-muted extra-small">bez DPH</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-wood-sand-subtle text-center border border-wood-sand">
                            <div class="text-muted small mb-1">Prodejní cena</div>
                            <div class="fs-4 price-display price-selling">
                                <span class="margin-arrow-up"><i class="bi bi-arrow-up-short"></i></span>@Model.Product.SellingPrice.ToString("C2")
                            </div>
                            <div class="text-muted extra-small">koncová cena pro e-shop</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-3 bg-wood-sand-subtle text-center border border-wood-sand">
                            <div class="text-muted small mb-1">Kalkulovaný zisk (marže)</div>
                            <div class="fs-4 price-display text-wood-terracotta">@margin.ToString("C2")</div>
                            <div class="extra-small mt-1">
                                <span class="badge @(marginPercent >= 100 ? "badge-active" : "badge-margin")">
                                    <i class="bi bi-graph-up me-1"></i>+@marginPercent.ToString("F0") %
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="border p-3 bg-white border-wood-sand">
                    <h6 class="fw-bold mb-2 text-wood-dark"><i class="bi bi-clock-history me-1 text-wood-terracotta"></i>Systémová evidence</h6>
                    <div class="row small text-muted">
                        <div class="col-6">Založeno v systému: <strong>@Model.Product.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong></div>
                        <div class="col-6">Poslední aktualizace: <strong>@(Model.Product.UpdatedAt.HasValue ? Model.Product.UpdatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "Původní záznam")</strong></div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top border-wood-sand d-flex justify-content-between">
                    <a asp-page="./Index" class="btn btn-outline-wood-pine">
                        <i class="bi bi-arrow-left me-1"></i> Zpět na katalog
                    </a>
                    <a asp-page="./Edit" asp-route-id="@Model.Product.Id" class="btn btn-wood-pine">
                        <i class="bi bi-pencil me-1"></i> Upravit produkt
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
